{
  "name": "daocafe-sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for DAO.CAFE - CreateDAO governance data read directly from the chain via RPC (no indexer)",
  "author": "dikobay",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "verify": "node scripts/verify-onchain.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "viem": ">=2.21.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "viem": "^2.43.3"
  },
  "keywords": [
    "dao",
    "governance",
    "ethereum",
    "createdao",
    "web3",
    "react",
    "hooks",
    "rpc",
    "arbitrum"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/daocafe/daocafe-sdk"
  },
  "homepage": "https://dao.cafe",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
